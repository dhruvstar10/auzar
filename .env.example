# Copy to .env (gitignored) and fill in. Never commit .env.
# From Foundry portal → proj-sbsi → Models + endpoints → realtime-mini
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=realtime-mini
# Chat-completions deployment for high-detail photo reading (tools/vision_test.py, VisionClient.swift)
AZURE_OPENAI_VISION_DEPLOYMENT=vision
