// Copy to Secrets.xcconfig (gitignored), or run tools/gen_ios_secrets.sh to generate it from .env.
// xcconfig treats "//" as a comment, so use the bare host, not an https:// URL.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
AZURE_OPENAI_HOST = your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY = your-key
AZURE_OPENAI_REALTIME_DEPLOYMENT = realtime-mini
